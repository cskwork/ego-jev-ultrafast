# Copy to jego.local.env (git-ignored). Non-secret settings only; keys live in Keychain.

# Option A: text fields through a signed-in Codex CLI (no API key).
TEXT_MODEL_PROVIDER=codex
TEXT_MODEL=gpt-6-luna
TEXT_MODEL_REASONING=low
CODEX_BIN=/absolute/path/to/codex

# Option B: any OpenAI-compatible endpoint; key in Keychain item jego-text-model.
# TEXT_MODEL_BASE_URL=https://api.openai.com/v1
# TEXT_MODEL=gpt-4.1-mini
